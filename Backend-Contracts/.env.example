# Copy to .env. Never commit the real file — it is gitignored for a reason.

# Sepolia RPC that serves historical eth_getLogs.
SEPOLIA_RPC_URL=

# Etherscan V2 key, used by `npm run contract:verify`.
ETHERSCAN_API_KEY=

# Address to verify, once deployed.
CONTRACT_ADDRESS=0x26Eb4c3f71ab6735e6c4b5a04D88fa902c46C8B3

# --- Deployer key -----------------------------------------------------------
# Do NOT put PRIVATE_KEY here. A plaintext key in the working tree is one
# `git add -f` or one shared screen away from being spent. Import it once into
# an encrypted Foundry keystore instead:
#
#   cast wallet import deployer --interactive
#
# then deploy with `--account deployer` and Foundry will prompt for the
# passphrase. Nothing sensitive ever touches the repository.
