# --- Frontend (Vite) ---------------------------------------------------------
# All VITE_* values are baked into the public bundle. Never put a secret here.

# Deployed CredentialVault. Defaults to the Sepolia deployment in src/lib/contract.ts.
VITE_CONTRACT_ADDRESS=0x26Eb4c3f71ab6735e6c4b5a04D88fa902c46C8B3
VITE_CHAIN_ID=11155111

# Optional: preferred Sepolia RPC, tried before the built-in public endpoints.
# Must serve historical eth_getLogs — many free endpoints do not.
# VITE_RPC_URL=

# Where the serverless pinning proxy is deployed (see api/pin.ts).
# Defaults to /api/pin, which works when the app and function share a host.
# VITE_PIN_ENDPOINT=https://your-project.vercel.app/api/pin

# Optional: preferred IPFS read gateway, tried before the public fallbacks.
# VITE_IPFS_GATEWAY=https://your-gateway.mypinata.cloud/ipfs/

# --- Serverless function (server-side only, NOT exposed to the browser) ------
# Pinata JWT with pinJSONToIPFS permission. Set this in your hosting provider's
# environment settings, never in a VITE_ variable.
# PINATA_JWT=
# ALLOWED_ORIGIN=https://your-site.example
