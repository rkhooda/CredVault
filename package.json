{
  "name": "credvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verifiable academic credentials on Ethereum. The chain proves the credential, a keccak256 hash binds it to the document, and the holder keeps the only key that reads it.",
  "author": "Rakshit Hooda <sewakunjtechnologies@gmail.com> (https://github.com/rkhooda)",
  "license": "MIT",
  "homepage": "https://cred-vaulte.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkhooda/CredVault.git"
  },
  "bugs": {
    "url": "https://github.com/rkhooda/CredVault/issues"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "verifiable-credentials",
    "blockchain",
    "ipfs",
    "keccak256",
    "aes-gcm",
    "foundry",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:build": "forge build --root Backend-Contracts --sizes",
    "contract:test": "forge test --root Backend-Contracts",
    "contract:fmt": "forge fmt --root Backend-Contracts",
    "contract:abi": "npm run contract:build --silent && node scripts/generate-abi.mjs",
    "contract:coverage": "forge coverage --root Backend-Contracts --no-match-coverage script",
    "contract:deploy": "forge script DeployVault --root Backend-Contracts --rpc-url \"$SEPOLIA_RPC_URL\" --broadcast -vvv",
    "contract:verify": "forge verify-contract --root Backend-Contracts --chain sepolia --watch $CONTRACT_ADDRESS src/CredentialVault.sol:CredentialVault"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
